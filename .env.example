# Supabase Postgres — bắt buộc cả dev lẫn production (schema provider là
# postgresql, SQLite không dùng được nữa; xem docs/deploy.md).
# DATABASE_URL qua pooler (6543), DIRECT_URL nối thẳng (5432) cho migrate.
DATABASE_URL="postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://...supabase.com:5432/postgres"

# ---- Supabase Storage ----
# Có 2 biến này → ảnh upload lên bucket public "uploads"; trống → lưu local.
# ⚠️ SERVICE_ROLE_KEY phải là legacy JWT dạng "eyJ..." — key mới "sb_secret_..."
# bị Storage API từ chối (Invalid Compact JWS).
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# URL gốc của app (dùng trong link email)
APP_URL="http://localhost:3000"

# ---- Email: chuỗi dự phòng Brevo → Gmail SMTP (xem docs/email.md) ----
# Cả 2 nhóm đều trống → email vào hộp thư dev tại /dev/mailbox.

# Đường CHÍNH (tùy chọn): Brevo — free 300 mail/ngày, https://app.brevo.com
# BREVO_FROM phải là sender đã verify trên dashboard Brevo (Settings → Senders).
# BREVO_API_KEY="xkeysib-..."
# BREVO_FROM="your@gmail.com"

# Đường DỰ PHÒNG: Gmail SMTP (~500 mail/ngày — vượt là Google chặn gửi 24-72h).
# Gmail: bật 2FA rồi tạo App Password tại https://myaccount.google.com/apppasswords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="app-password-16-ky-tu"
# SMTP_FROM="DEAL <your@gmail.com>"

# ---- Web Push (thông báo đẩy lên điện thoại) ----
# Sinh 1 lần: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Thiếu 2 biến đầu → tính năng tự tắt (nút bật thông báo ẩn), web vẫn chạy bình thường.
# VAPID_PUBLIC_KEY="B..."   (lộ ra client là bình thường)
# VAPID_PRIVATE_KEY="..."   (BÍ MẬT, không commit)
# VAPID_SUBJECT="mailto:your@gmail.com"

# ---- Chế độ trưng bày tin đã bán (xem docs/showcase.md) ----
# Mặc định BẬT: tin ĐÃ BÁN vẫn nằm trên bảng tin (xám + băng chéo đỏ "SOLD",
# dồn xuống cuối) cho chợ đỡ trống khi còn ít người dùng.
# TẮT: đặt off rồi redeploy. Chỉ áp cho "closed" (đã bán), không áp cho tin bị gỡ.
# SHOW_SOLD_LISTINGS="off"
