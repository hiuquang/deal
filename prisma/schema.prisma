// Postgres hỗ trợ enum thật, nhưng giữ String để tương thích với zod ép kiểu
// hiện có (src/server/validation.ts) — đổi enum là việc khác, không phải cutover.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  displayName     String    @map("display_name")
  emailVerifiedAt DateTime? @map("email_verified_at") // null = chưa xác nhận email
  // Phiên bản 利用規約 user đã đồng ý (null/khác bản hiện hành = phải đồng ý lại)
  termsAcceptedVersion String?   @map("terms_accepted_version")
  termsAcceptedAt      DateTime? @map("terms_accepted_at")
  // Chỉ chủ web bật thủ công (Supabase → cột is_vip). Hiển thị vương miện + nhãn
  // VIP ở mọi nơi kèm tên; nâng level sàn lên 10 (xem profile-service).
  isVip           Boolean   @default(false) @map("is_vip")
  // Mốc "đã xem hoạt động" (comment vào tin mình, 購入希望, chào bán tin gom).
  // Set khi mở trang cá nhân; item mới hơn mốc = new → badge đỏ ở nav.
  activitySeenAt  DateTime? @map("activity_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  sessions        Session[]
  listings        Listing[]
  conversations       Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messages        Message[]
  tradesAsBuyer   Trade[]        @relation("TradeBuyer")
  tradesAsSeller  Trade[]        @relation("TradeSeller")
  ratingsGiven     Rating[]          @relation("RatingsGiven")
  ratingsReceived  Rating[]          @relation("RatingsReceived")
  reportsMade      Report[]          @relation("ReportsMade")
  reportsReceived  Report[]          @relation("ReportsReceived")
  comments         Comment[]
  purchaseRequests PurchaseRequest[]
  buyOrders        BuyOrder[]
  buyOrderOffers   BuyOrderOffer[]
  emailTokens      EmailToken[]
  favorites        Favorite[]

  @@map("users")
}

// Tin đã lưu (❤️): user lưu 1 listing HOẶC 1 buy-order để xem lại ở trang cá
// nhân. Đúng 1 trong 2 FK khác null (enforce ở service). onDelete Cascade: tin
// bị xóa cứng thì bản lưu cũng đi — nhưng listing/buy-order hiện chỉ soft-status
// (cancelled/closed) nên thực tế bản lưu vẫn còn, UI hiện "không còn".
model Favorite {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  listingId  String?  @map("listing_id")
  buyOrderId String?  @map("buy_order_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing  Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyOrder BuyOrder? @relation(fields: [buyOrderId], references: [id], onDelete: Cascade)

  // NULL distinct trong Postgres → 2 unique này chặn trùng lượt lưu listing và
  // trùng lượt lưu buy-order riêng biệt (không cản nhau).
  @@unique([userId, listingId])
  @@unique([userId, buyOrderId])
  @@index([userId, createdAt])
  @@map("favorites")
}

// Token xác nhận email / đặt lại mật khẩu — dùng 1 lần, có hạn.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  type      String // verify | reset
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

// Hộp thư dev: khi chưa cấu hình SMTP, email "gửi đi" được lưu vào đây
// và xem tại /dev/mailbox (chỉ dev). Có SMTP thật thì bảng này không dùng.
model EmailOutbox {
  id        String   @id @default(cuid())
  toEmail   String   @map("to_email")
  subject   String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_outbox")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Card {
  id         String   @id @default(cuid())
  game       String // pokemon | onepiece | other (sản phẩm ngoài 2 game, user tự đặt tên)
  category   String   @default("single") // single | box (sealed booster box)
  setCode    String   @map("set_code") // other dùng "OTHER" / "OTHER-BOX"
  cardNumber String   @map("card_number") // box dùng "BOX"; other dùng chính tên sản phẩm (dedupe qua unique)
  language   String // JP | EN
  nameJa     String   @map("name_ja")
  nameEn     String   @map("name_en")
  rarity     String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  listings     Listing[]
  priceRecords PriceRecord[]
  buyOrders    BuyOrder[]
  trades       Trade[]

  @@unique([game, setCode, cardNumber, language])
  @@map("cards")
}

model Listing {
  id             String   @id @default(cuid())
  sellerId       String   @map("seller_id")
  cardId         String   @map("card_id")
  condition      String // PSA10 | PSA9 | BGS95 | RAW_NM | RAW_LP | RAW_MP | RAW_HP | DAMAGED
  imageUrl       String   @map("image_url")
  askingPriceJpy Int?     @map("asking_price_jpy")
  // Số lượng cùng loại người bán đang có (thông tin để thương lượng; luồng
  // trade hiện vẫn đóng listing khi 1 giao dịch chốt — chưa trừ tồn từng đơn).
  quantity       Int      @default(1)
  tradeType      String   @map("trade_type") // sell | trade
  // Ga gần nhất (最寄り駅) — cho người mua biết khu vực để hẹn 手渡し. Tùy chọn.
  station        String?
  note           String?
  status         String   @default("active") // active | in_trade | closed | cancelled
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  seller           User              @relation(fields: [sellerId], references: [id])
  card             Card              @relation(fields: [cardId], references: [id])
  conversations    Conversation[]
  trades           Trade[]
  comments         Comment[]
  purchaseRequests PurchaseRequest[]
  favorites        Favorite[]

  @@index([cardId, status])
  @@index([sellerId])
  // Trang chủ: WHERE status='active' ORDER BY created_at DESC — query nóng nhất
  @@index([status, createdAt])
  @@map("listings")
}

// Bình luận công khai dưới listing: ai cũng đọc, đăng nhập mới viết.
model Comment {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  userId    String   @map("user_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([listingId, createdAt])
  @@map("comments")
}

// Yêu cầu mua: buyer bấm 購入希望 → seller chọn ai để 連携 (tạo conversation).
// Conversation CHỈ sinh ra qua connect — seller toàn quyền chọn đối tác.
model PurchaseRequest {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  buyerId   String   @map("buyer_id")
  status    String   @default("pending") // pending | connected
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id])

  @@unique([listingId, buyerId])
  @@index([listingId, status])
  @@map("purchase_requests")
}

// Hội thoại riêng 1-1. Nguồn gốc: hoặc từ 1 listing (người mua ↔ người bán của
// listing), hoặc từ 1 tin gom số lượng lớn (BuyOrder: người mua = chủ tin ↔
// người bán đã chào bán). sellerId lưu trực tiếp (không suy từ listing nữa) để
// hỗ trợ cả hai nguồn — xem migration backfill cho hàng cũ.
model Conversation {
  id         String  @id @default(cuid())
  listingId  String? @map("listing_id")  // null nếu hội thoại đến từ BuyOrder
  buyOrderId String? @map("buy_order_id") // null nếu hội thoại đến từ Listing
  buyerId    String  @map("buyer_id")
  sellerId   String  @map("seller_id") // NOT NULL từ P9.1 (backfill xong ở P8)
  // Mốc "đã đọc" của từng bên (null = chưa mở lần nào). Tin chưa đọc = tin của
  // bên kia có created_at > mốc này. Buyer null khi vừa được match → báo là 1.
  buyerLastReadAt  DateTime? @map("buyer_last_read_at")
  sellerLastReadAt DateTime? @map("seller_last_read_at")
  // Vòng đời chat sau giao dịch: khi trade chốt + CẢ 2 đã đánh giá, đặt
  // messagesPurgeAt = now + 1 ngày. Sweep lazy xóa nội dung tin nhắn khi tới
  // hạn rồi ghi messagesPurgedAt (null = chưa xóa). Giữ conversation + trade
  // history + price_records — chỉ xóa nội dung messages.
  messagesPurgeAt  DateTime? @map("messages_purge_at")
  messagesPurgedAt DateTime? @map("messages_purged_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing  Listing?  @relation(fields: [listingId], references: [id])
  buyOrder BuyOrder? @relation(fields: [buyOrderId], references: [id])
  buyer    User      @relation("ConversationBuyer", fields: [buyerId], references: [id])
  seller   User      @relation("ConversationSeller", fields: [sellerId], references: [id])
  messages Message[]
  trades   Trade[]

  @@unique([listingId, buyerId])
  @@unique([buyOrderId, sellerId])
  // Poll tin chưa đọc (15s/user đăng nhập) lọc OR buyer_id/seller_id —
  // 2 index này phục vụ query nóng nhất của app.
  @@index([buyerId])
  @@index([sellerId])
  // Sweep xóa chat: WHERE messages_purge_at <= now AND messages_purged_at IS NULL
  @@index([messagesPurgeAt])
  @@map("conversations")
}

// Tin "gom số lượng lớn" (まとめ買い募集): người mua đăng nhu cầu cần N bản của
// 1 thẻ. Người bán xem và chào bán (BuyOrderOffer). Giai đoạn 1: chỉ kết nối
// sang chat riêng, CHƯA ghi giá (để Giai đoạn 2).
model BuyOrder {
  id              String   @id @default(cuid())
  buyerId         String   @map("buyer_id")
  cardId          String   @map("card_id")
  quantity        Int // số lượng cần gom (1..999)
  maxUnitPriceJpy Int?     @map("max_unit_price_jpy") // đơn giá tối đa mong muốn, tùy chọn
  status          String   @default("active") // active | cancelled
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  buyer         User            @relation(fields: [buyerId], references: [id])
  card          Card            @relation(fields: [cardId], references: [id])
  offers        BuyOrderOffer[]
  conversations Conversation[]
  trades        Trade[]
  favorites     Favorite[]

  @@index([cardId, status])
  @@index([status, createdAt])
  @@index([buyerId])
  @@map("buy_orders")
}

// Chào bán công khai dưới 1 tin gom: người bán báo số lượng mình bán được +
// lời nhắn ngắn. Người mua (chủ tin) chọn 1 chào bán → sinh conversation riêng.
model BuyOrderOffer {
  id         String   @id @default(cuid())
  buyOrderId String   @map("buy_order_id")
  sellerId   String   @map("seller_id")
  quantity   Int // số lượng người bán muốn bán
  message    String? // lời nhắn ngắn (≤300), tùy chọn
  status     String   @default("pending") // pending | connected
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  buyOrder BuyOrder @relation(fields: [buyOrderId], references: [id], onDelete: Cascade)
  seller   User     @relation(fields: [sellerId], references: [id])

  @@unique([buyOrderId, sellerId])
  @@index([buyOrderId, createdAt])
  @@map("buy_order_offers")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Trade đến từ listing HOẶC buy-order (P9). card_id/condition/quantity
// denormalize lên trades (nguồn cho price_record, hết phụ thuộc listing):
// - listing trade: copy từ listing lúc tạo, quantity=1, final_price_jpy = giá thẻ.
// - buy-order trade: bên khởi tạo khai condition + quantity; final_price_jpy
//   là ĐƠN GIÁ (giá/1 bản) — price_record ghi đơn giá để so sánh được.
// Chống race: partial unique index trades_one_active_per_listing (cũ) +
// trades_one_active_per_conversation (P9) — xem migration.
model Trade {
  id             String    @id @default(cuid())
  listingId      String?   @map("listing_id") // null nếu trade từ buy-order
  buyOrderId     String?   @map("buy_order_id") // null nếu trade từ listing
  conversationId String    @map("conversation_id")
  sellerId       String    @map("seller_id")
  buyerId        String    @map("buyer_id")
  initiatorId    String    @map("initiator_id")
  cardId         String    @map("card_id")
  condition      String
  quantity       Int       @default(1)
  finalPriceJpy  Int       @map("final_price_jpy") // đơn giá (giá/1 bản)
  status         String    @default("pending") // pending | confirmed | self_reported | cancelled
  autoCloseAt    DateTime  @map("auto_close_at")
  confirmedAt    DateTime? @map("confirmed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  listing      Listing?     @relation(fields: [listingId], references: [id])
  buyOrder     BuyOrder?    @relation(fields: [buyOrderId], references: [id])
  card         Card         @relation(fields: [cardId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  seller       User         @relation("TradeSeller", fields: [sellerId], references: [id])
  buyer        User         @relation("TradeBuyer", fields: [buyerId], references: [id])
  priceRecord  PriceRecord?
  ratings      Rating[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@map("trades")
}

// Rating blind-mutual: mỗi bên rate 1 lần/trade; chỉ "reveal" (hiện cho nhau
// và tính vào ★ trung bình) khi trade có đủ 2 rating — chống trả đũa.
model Rating {
  id        String   @id @default(cuid())
  tradeId   String   @map("trade_id")
  raterId   String   @map("rater_id")
  rateeId   String   @map("ratee_id")
  score     Int // 1–5, ép ở tầng zod
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trade Trade @relation(fields: [tradeId], references: [id])
  rater User  @relation("RatingsGiven", fields: [raterId], references: [id])
  ratee User  @relation("RatingsReceived", fields: [rateeId], references: [id])

  @@unique([tradeId, raterId])
  @@index([rateeId])
  @@map("ratings")
}

model Report {
  id             String    @id @default(cuid())
  reporterId     String    @map("reporter_id")
  reportedUserId String    @map("reported_user_id")
  listingId      String?   @map("listing_id")
  reason         String
  // pending (mặc định) | verified | dismissed. Hồ sơ công khai CHỈ hiện vi
  // phạm đã verified — report lẻ chưa duyệt không được làm xấu mặt ai (chống
  // report bẩn). Chưa có admin UI: duyệt tạm bằng tay ở DB.
  status         String    @default("pending")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id])
  reported User @relation("ReportsReceived", fields: [reportedUserId], references: [id])

  @@index([reportedUserId])
  @@map("reports")
}

// Ẩn danh từ tầng schema: KHÔNG có cột user nào — bảng này an toàn để
// public/export cho AI. card_id/condition denormalize từ listing để query
// giá không phải join qua trades/listings.
model PriceRecord {
  id          String   @id @default(cuid())
  tradeId     String   @unique @map("trade_id")
  cardId      String   @map("card_id")
  condition   String
  priceJpy    Int      @map("price_jpy")
  reliability String // confirmed | self_reported
  // true = lệch >50% so với median thị trường tại thời điểm tạo → loại khỏi
  // stats/chart, vẫn hiện trong bảng kèm cảnh báo (chống thông đồng bơm giá).
  flagged     Boolean  @default(false)
  tradedAt    DateTime @map("traded_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  trade Trade @relation(fields: [tradeId], references: [id])
  card  Card  @relation(fields: [cardId], references: [id])

  @@index([cardId, condition, tradedAt])
  @@map("price_records")
}

// Bộ đếm rate limit (fixed window). Không có FK tới User — key là chuỗi tự do
// ("login:ip:1.2.3.4", "forgot:email:a@b.c") nên chặn được cả người chưa đăng
// nhập. Phải nằm ở DB chứ không phải RAM: Vercel serverless nhiều instance +
// cold start liên tục → đếm trong RAM vô nghĩa.
model RateLimit {
  key       String   @id
  count     Int      @default(1)
  windowEnd DateTime @map("window_end")

  // Phục vụ dọn rác lazy (xóa cửa sổ đã hết hạn).
  @@index([windowEnd])
  @@map("rate_limits")
}
